// The HPKE base mode, and the one hybrid KEM the post-quantum recipient uses.
//
// RFC 9180 §6.1, base mode, with no pre-shared key and a single message per
// context: a file key is sealed once and the context is thrown away, so the
// sequence number never advances past zero and the export interface is not
// needed.
//
// The KEM is MLKEM768-X25519 (X-Wing) from draft-ietf-hpke-pq: an ML-KEM-768
// encapsulation key with an X25519 public key behind it, combined into one
// secret with SHA3-256 rather than negotiated. A secret key is a single
// thirty-two-byte seed, expanded by SHAKE256 into both halves.
import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonseal/spec",
  "moonbitstack/mooncrypt/aead/chachapoly",
  "moonbitstack/mooncrypt/hash/sha2",
  "moonbitstack/mooncrypt/hash/sha3",
  "moonbitstack/mooncrypt/kdf/hkdf",
  "moonbitstack/mooncrypt/kex/x25519",
  "moonbitstack/mooncrypt/pq/mlkem",
  "moonbitstack/mooncrypt/spec" @cryptspec,
  "moonbitstack/moonseed",
}
