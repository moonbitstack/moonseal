// The site's engine: moonseal built to JavaScript for the console on the home
// page. Strings in, JSON out; every file it prints is an age file this library
// sealed.
import {
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonseal",
  "moonbitstack/moonseal/armor",
  "moonbitstack/moonseal/header",
  "moonbitstack/moonseal/scrypt",
  "moonbitstack/moonseal/spec",
  "moonbitstack/moonseal/x25519",
  "moonbitstack/moonseal/mlkem768x25519",
  "moonbitstack/moonseal/p256tag",
  "moonbitstack/moonseal/mlkem768p256tag",
  "moonbitstack/moonbase/base16",
  "moonbitstack/moonseal/ssh",
  "moonbitstack/moonseed/system",
}

options(
  link: {
    "js": {
      "exports": [
        "keygen",
        "keygen_pq",
        "keygen_tag",
        "keygen_tag_pq",
        "seal_passphrase",
        "seal_to",
        "open_passphrase",
        "open_with",
        "open_tag",
        "open_tag_pq",
        "inspect",
      ],
      "format": "esm",
    },
  },
)
