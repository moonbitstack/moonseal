// The C2SP age test vectors, as a package: one entry per case, the file itself
// included.
//
// `vectors.mbt` is generated by `scripts/vectors.py`; the tests that read it are
// next to it. Keeping the data in the build rather than on disk is what lets the
// suite run on a backend with no filesystem.
//
// Warning 33 is the formatter asking for a 89 KiB literal to be broken up by
// hand. The generator already breaks it into 48-column pieces; there is nothing
// here for a person to tidy, so the ask is turned off for this package alone.

warnings = "-33"

import {
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonseal",
  "moonbitstack/moonbase/base64",
  "moonbitstack/moonseal/scrypt",
  "moonbitstack/moonseal/spec",
  "moonbitstack/moonseal/x25519",
  "moonbitstack/mooncrypt/cipher/chacha20",
  "moonbitstack/mooncrypt/hash/sha2",
  "moonbitstack/moonrand",
} for "test"
